{
  "id": "6a65616e757673756776000000000065",
  "mode": "router",
  "listen": {
    "endpoints": [
      "tcp/0.0.0.0:7447"
    ]
  },
  "connect": {
    "timeout_ms": {
      "router": 1000,
      "peer": 1000
    },
    "endpoints": [
      "tcp/192.168.3.66:7447",
      "tcp/192.168.3.67:7447",
      "tcp/192.168.3.68:7447",
      "tcp/192.168.3.69:7447",
      "tcp/192.168.3.70:7447",
      "tcp/192.168.3.71:7447",
      "tcp/192.168.3.72:7447",
      "tcp/192.168.3.73:7447"
    ],
    "retry": {
      "period_init_ms": 1000,
      "period_max_ms": 5000,
      "period_increase_factor": 2
    }
  },
  "scouting": {
    "multicast": { "enabled": false },
    "gossip": { "enabled": true, "multihop": true }
  },
  "routing": {
    "router": {
      "peers_failover_brokering": true
    },
    "interests": {
      "timeout": 10000
    }
  },
  "timestamping": {
    "enabled": { "router": true, "peer": true, "client": true },
    "drop_future_timestamp": false
  },
  "downsampling": [],
  "access_control": {
    "enabled": true,
    "default_permission": "deny",
    "rules": [
      {
        "id": "allow_filtered_topics",
        "permission": "allow",
        "messages": ["put", "declare_subscriber"],
        "flows": ["ingress", "egress"],
        "key_exprs": [
          "filtered/**"
        ]
      },
      {
        "id": "allow_mesh_control",
        "permission": "allow",
        "messages": ["put", "declare_subscriber"],
        "flows": ["ingress", "egress"],
        "key_exprs": [
          "mesh/**"
        ]
      },
      {
        "id": "allow_ros2_node_discovery",
        "permission": "allow",
        "messages": ["put", "delete", "declare_subscriber", "query", "declare_queryable", "reply", "liveliness_token", "declare_liveliness_subscriber", "liveliness_query"],
        "flows": ["ingress", "egress"],
        "key_exprs": [
          "@ros2/**",
          "@ros2_lv/**",
          "@ros2_tp/**",
          "@ros2_pub/**",
          "@ros2_sub/**",
          "@ros2_service/**",
          "@ros2_node/**",
          "@ros2_graph/**",
          "@ros2_liveliness/**",
          "@ros2_admin/**",
          "ros2/**",
          "50/**",
          "40/**",
          "55/**",
          "0/**",
          "**"
        ]
      }
    ],
    "subjects": [
      { "id": "all" },
      { "id": "anonymous" },
      { "id": "*" }
    ],
    "policies": [
      {
        "rules": ["allow_filtered_topics", "allow_mesh_control", "allow_ros2_node_discovery"],
        "subjects": ["all", "anonymous", "*"]
      }
    ]
  },
  "transport": {
    "unicast": {
      "open_timeout": 30000,
      "accept_timeout": 30000,
      "accept_pending": 10000,
      "max_sessions": 10000,
      "qos": { "enabled": true },
      "compression": { "enabled": true }
    },
    "link": {
      "tx": {
        "lease": 10000,
        "keep_alive": 4,
        "batch_size": 65536,
        "queue": {
          "batching": {
            "enabled": true,
            "time_limit": 1
          }
        }
      },
      "rx": {
        "buffer_size": 20971520
      }
    }
  },
  "adminspace": {
    "enabled": false,
    "permissions": {
      "read": false,
      "write": false
    }
  }
}
