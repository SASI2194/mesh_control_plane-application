{
  "mode": "peer",
  "connect": {
    "timeout_ms": {
      "router": 1000,
      "peer": 1000
    },
    "endpoints": [
      "tcp/192.168.3.65:7447",
      "tcp/192.168.3.66:7447",
      "tcp/192.168.3.67:7447",
      "tcp/192.168.3.68:7447",
      "tcp/192.168.3.69:7447",
      "tcp/192.168.3.70:7447",
      "tcp/192.168.3.71:7447",
      "tcp/192.168.3.72:7447",
      "tcp/192.168.3.73:7447"
    ],
    "retry": {
      "period_init_ms": 500,
      "period_max_ms": 2000,
      "period_increase_factor": 1.5
    }
  },
  "listen": {
    "endpoints": ["tcp/0.0.0.0:7447"]
  },
  "scouting": {
    "multicast": { "enabled": false },
    "gossip": { "enabled": false, "multihop": false }
  },
  "routing": {
    "peer": {
      "mode": "peer_to_peer"
    },
    "interests": {
      "timeout": 5000
    }
  },
  "timestamping": { "enabled": { "router": true, "peer": true, "client": true } },
  "access_control": {
    "enabled": true,
    "default_permission": "deny",
    "rules": [
      {
        "id": "allow_filtered_topics",
        "permission": "allow",
        "messages": ["put", "declare_subscriber"],
        "flows": ["egress", "ingress"],
        "key_exprs": ["filtered/**", "mesh_control/**", "zenoh/**"]
      }
    ]
  },
  "transport": {
    "link": {
      "tx": {
        "queue": {
          "batching": {
            "enabled": true,
            "time_limit": 1
          }
        }
      }
    }
  }
}
